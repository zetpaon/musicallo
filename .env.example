# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
# IMPORTANT: Never commit .env file with real credentials to version control!

FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_app_id

# Application Settings
ENVIRONMENT=development
DEBUG_MODE=false

# Tracks Data URL
TRACKS_DATA_URL=https://raw.githubusercontent.com/zetpaon/musicallo/refs/heads/data/tracks.json

# Game Settings
MAX_ATTEMPTS=6
BONUS_STEP=0
AUDIO_START_OFFSET=0.25
WEEKLY_COOLDOWN_MS=604800000

# Level System
INITIAL_LEVEL_THRESHOLD=150
