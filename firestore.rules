rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow create, read, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['nickname', 'avatarUrl', 'score'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 32
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 2048
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
    }

    match /packs/{packId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'description', 'icon', 'color', 'tracks', 'creatorId', 'createdAt', 'plays'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 480
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 16
        && request.resource.data.color is string
        && request.resource.data.color.size() <= 16
        && request.resource.data.tracks is list
        && request.resource.data.tracks.size() > 0
        && request.resource.data.tracks.size() <= 20
        && request.resource.data.plays == 0;
      allow update, delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }

    match /packScores/{scoreId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && scoreId.matches('.*_' + request.auth.uid)
        && request.resource.data.keys().hasOnly(['packId', 'nickname', 'score'])
        && request.resource.data.packId is string
        && request.resource.data.packId.size() <= 128
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 32
        && request.resource.data.score is number
        && request.resource.data.score >= 0;
    }
  }
}
